# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & local secrets (never commit)
.env*
.dev.vars
.openai/

# deploy artifacts
deploy.zip
*.zip

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# .NET
bin/
obj/
*.db
*.db-shm
*.db-wal
