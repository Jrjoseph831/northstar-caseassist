{
  "ConnectionStrings": {
    "Northstar": "Data Source=work/northstar.local.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Search": {
    "Provider": "Database",
    "IndexName": "approved-policy-sections-v1"
  },
  "Retrieval": {
    "QueryVariants": 4,
    "CandidatePoolSize": 24,
    "RerankDepth": 8,
    "FusionConstant": 60,
    "RerankWeight": 0.25,
    "UseQueryExpansion": true,
    "UseReranking": true,
    "EmbeddingProvider": "LocalDeterministic",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 512,
    "QueryExpansionProvider": "Deterministic"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "work/documents"
  },
  "ContentSafety": {
    "Provider": "DeterministicLocal"
  },
  "AI": {
    "Provider": "OfflineFixture",
    "Model": "gpt-5-mini",
    "InputPricePerMillion": 0.25,
    "OutputPricePerMillion": 2.0,
    "DailyRequestLimit": 40,
    "DailyCostLimitUsd": 0.25
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://northstar-caseassist-demo.falajoe.chatgpt.site"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
